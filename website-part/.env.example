NODE_ENV=development
PORT=3000
BIND_IP=127.0.0.1
SESSION_COOKIE_NAME=connect.sid
# Generate a unique value with openssl rand -hex 32 before startup.
SESSION_SECRET=
# Require account holders to explicitly accept the Terms of Service and data-storage notice.
TERMS_OF_SERVICE_REQUIRED=true
PROXY_ALLOW_SELF_SIGNED=false
# Comma-separated user groups allowed to use SSH and RDP. Defaults to admin when unset.
REMOTE_ALLOWED_GROUPS=admin
# Set either feature to false to disable it for every user, including administrators.
REMOTE_SSH_ENABLED=true
REMOTE_RDP_ENABLED=true
# Comma-separated SSH hosts or IPv4 CIDR ranges permitted by the server. Leave empty only on a trusted network.
# Example: 192.0.2.0/24,ssh.example.org
SSH_ALLOWED_HOSTS=
# Base64-encoded 32-byte key for AES-256-GCM server-side remote-profile storage.
# Generate with: openssl rand -base64 32
REMOTE_CREDENTIAL_ENCRYPTION_KEY=
# Server-side Chromium. Set this to an installed Chrome/Chromium executable when it is not on PATH.
CHROME_EXECUTABLE_PATH=
# OpenWrt mode: connect to Chrome running on another machine instead of launching locally.
# Example: http://browser.example.org:9222
CHROME_CDP_URL=
# Explicit hostnames/IPs permitted to reach private destinations in Chromium.
# The per-session proxy validates and pins HTTP(S)/WebSocket destinations,
# including workers and popups. Restrict the browser host's network too.
CHROMIUM_ALLOWED_HOSTS=
# For local Chrome/loopback CDP these may stay empty (loopback defaults).
# Non-loopback CDP requires ALL three; Chrome must reach the advertised host
# and dynamically allocated proxy TCP ports. Permit only Chrome source IPs.
CHROMIUM_PROXY_BIND_HOST=
CHROMIUM_PROXY_ADVERTISED_HOST=
CHROMIUM_PROXY_ALLOWED_CLIENT_IPS=
# Remote Chrome must run with --enable-automation and
# --webrtc-ip-handling-policy=disable_non_proxied_udp (verified on connect).
# Maximum lifetime of one browser WebSocket session in milliseconds.
CHROMIUM_SESSION_TIMEOUT_MS=1800000
# Interim VLESS listener settings. The listener must route to
# VLESS_TUNNEL_INTERNAL_TARGET; the website only emits client configuration.
VLESS_TUNNEL_ADDRESS=
VLESS_TUNNEL_PORT=443
VLESS_TUNNEL_UUID=
VLESS_TUNNEL_NETWORK=tcp
VLESS_TUNNEL_SECURITY=tls
# Set to reality for XTLS Vision/Reality. Required when security=reality.
VLESS_TUNNEL_REALITY_PUBLIC_KEY=
VLESS_TUNNEL_REALITY_SHORT_ID=
VLESS_TUNNEL_CLIENT_FINGERPRINT=chrome
VLESS_TUNNEL_SNI=
VLESS_TUNNEL_PATH=/
VLESS_TUNNEL_HOST=
VLESS_TUNNEL_FLOW=
VLESS_TUNNEL_REMARK=LiuLianBot interim internal tunnel
VLESS_TUNNEL_INTERNAL_TARGET=web server internal network
VLESS_TUNNEL_TTL_SECONDS=3600
VLESS_TUNNEL_ALLOW_INSECURE=false

# RDP: comma-separated hostnames, IPs or IPv4 CIDRs. Private targets require an explicit match.
# Example: RDP_ALLOWED_HOSTS=192.0.2.0/24
RDP_ALLOWED_HOSTS=

# Set the website account ID of the file owner.
# Other accounts must receive read/write/share grants from this owner in /files.html.
FILES_OWNER_USER_ID=
# Server-only SFTP credentials. Only /vol*/1000 directories are exposed.
FILES_SFTP_HOST=
FILES_SFTP_PORT=22
FILES_SFTP_USER=
FILES_SFTP_PASSWORD=
# Expected SHA-256 host key digest as 64 hexadecimal characters (not base64).
FILES_SFTP_HOST_SHA256=

# Optional absolute path to Bot config; guild language updates require a writable parent directory for atomic rename.
DISCORD_CONFIG_PATH=

# Multi-VPS mode shares authentication limits through the existing MySQL database.
DISTRIBUTED_DEPLOYMENT=false
# Trusted proxy hops, or comma-separated IP/CIDR ranges; never use true.
# Production default is one trusted proxy. The app must not be publicly reachable.
TRUST_PROXY=1
# If DB_HOST is set, these replace shared/database/config.json.
# DB_HOST=db.example.org
# DB_PORT=3306
# DB_USER=website_app
# DB_PASSWORD=
# DB_NAME=discordbot
# DB_SSL_CA_FILE=/run/config/mysql-ca.pem

# Only the designated node with writable Bot config may update guild settings.
GUILD_CONFIG_WRITER=false

# Set false on regional nodes when Clash synchronization is owned by the router.
CLASH_SYNC_ENABLED=true
# Member mailboxes: API credentials stay on the server, never in VITE_* variables.
MAILU_API_URL=
MAILU_API_TOKEN=
MAILU_DOMAIN=
MAILU_WEBMAIL_URL=
MAILU_QUOTA_BYTES=1073741824

# Admin NetBird integration. Leave the token empty to disable it.
# Use a service-user Personal Access Token with permission to manage peers/networks.
# HTTPS URL including /api, for NetBird Cloud or your self-hosted management server.
NETBIRD_API_URL=https://api.netbird.io/api
NETBIRD_API_TOKEN=
