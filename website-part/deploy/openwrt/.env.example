# Copy to .env on the N100. Use the tested release tag or digest.
WEBSITE_IMAGE=liulianweb:n100
MYSQL_IMAGE=mysql:8.4
# Existing empty directory on the local SSD for a new database.
N100_MYSQL_DIR=/mnt/ssd/liulian/mysql
DB_NAME=discordbot
DB_USER=website_app
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Website runtime settings and existing secrets; see ../../.env.example.
WEBSITE_ENV_FILE=./website.env
WEBSITE_PORT=30012
BOT_DB_BIND_IP=127.0.0.1
BOT_DB_PORT=3307
