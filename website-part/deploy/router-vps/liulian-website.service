[Unit]
Description=LiuLian website regional node
Wants=network-online.target liulian-router-tunnel.service
After=network-online.target liulian-router-tunnel.service
[Service]
Type=simple
User=liulianweb
Group=liulianweb
WorkingDirectory=/opt/liulianweb/website-part
EnvironmentFile=/etc/liulianweb/website.env
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=5
TimeoutStopSec=45
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
[Install]
WantedBy=multi-user.target
