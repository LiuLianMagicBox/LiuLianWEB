# Copy to node.env on EVERY VPS. All nodes use the same primary database and secrets.
DB_HOST=db.example.org
DB_PORT=3306
DB_NAME=discordbot
DB_USER=website_app
DB_PASSWORD=
# For TLS database connections, mount the CA inside ./config.
# DB_SSL_CA_FILE=/run/config/mysql-ca.pem
SESSION_COOKIE_NAME=connect.sid
SESSION_SECRET=
REMOTE_CREDENTIAL_ENCRYPTION_KEY=
CLASH_CREDENTIAL_ENCRYPTION_KEY=
# Use identical allowlists and shared SFTP configuration on all nodes.
REMOTE_ALLOWED_GROUPS=admin
SSH_ALLOWED_HOSTS=
RDP_ALLOWED_HOSTS=
FILES_OWNER_USER_ID=
FILES_SFTP_HOST=
FILES_SFTP_PORT=22
FILES_SFTP_USER=
FILES_SFTP_PASSWORD=
FILES_SFTP_HOST_SHA256=
# Chromium is external to the image. Only expose CDP on a private network.
CHROME_CDP_URL=
# Remote Chrome must reach the website's per-session HTTP/CONNECT listeners.
# Use a routed private container network (dynamic TCP ports), not only port 3000.
# Set ALL three for a non-loopback CDP endpoint; restrict inbound to Chrome IPs.
CHROMIUM_PROXY_BIND_HOST=
CHROMIUM_PROXY_ADVERTISED_HOST=
CHROMIUM_PROXY_ALLOWED_CLIENT_IPS=
CHROMIUM_ALLOWED_HOSTS=
# Remote Chrome launch flags: --enable-automation
# --webrtc-ip-handling-policy=disable_non_proxied_udp
# Optional shared/read-only configuration, see README before enabling guild writes.
# Writer nodes mount the containing Discord settings directory read/write.
# DISCORD_CONFIG_PATH=/run/discord-settings/config.json
# Enable ONLY on the management node with the Bot config mounted read-write.
GUILD_CONFIG_WRITER=false
# CLASH_SSH_PROFILES_FILE=/run/config/ssh-profiles.json

# Set false on regional nodes when Clash synchronization is owned by the router.
CLASH_SYNC_ENABLED=true
